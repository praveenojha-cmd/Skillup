<?xml version="1.0" encoding="utf-8"?>
<!-- Official Rupeek emblem (app/src/main/res/drawable-nodpi/rupeek_emblem.png),
     losslessly cropped from the approved rupeek_logo.png artwork — no redraw,
     recolor, or distortion. Sized to 66dp within the 108dp adaptive-icon
     canvas so it sits inside the safe zone and isn't clipped by launcher
     masking (circle/squircle/rounded-square). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="66dp"
        android:height="66dp"
        android:gravity="center">
        <bitmap android:src="@drawable/rupeek_emblem" />
    </item>
</layer-list>
